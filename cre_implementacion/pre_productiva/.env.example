# Copiar como .env únicamente si una herramienta local lo requiere.
# No guardar tokens ni contraseñas en este archivo de ejemplo.
DATABRICKS_CONFIG_PROFILE=cresa-dev
# Para cluster clásico; omitir si se utiliza serverless.
DATABRICKS_CLUSTER_ID=<cluster-id>
# Para serverless, usar DATABRICKS_SERVERLESS_COMPUTE_ID=auto.

